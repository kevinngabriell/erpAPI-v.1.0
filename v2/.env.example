APP_ENV=development

# development = your_dev_host | production = 127.0.0.1
DB_HOST=your_dev_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_pass

CORE_SCHEMA=movira_core_dev
APP_SCHEMA=aluria_dev

# Shared with the legacy (/auth, /user, /company, /master, ...) stack via
# auth/JWTConfig.php — do not fork this value, or legacy-issued tokens will
# fail signature verification against v2 and vice versa.
JWT_SECRET="your_jwt_secret_here"

# Peppers (never returned by the API) — must match movira_api .env
OTP_PEPPER=

# External APIs (optional)
WAHA_BASE_URL=
WAHA_SESSION=
WAHA_API_KEY=

# Notification WebSocket daemon (v2/notification/ws-server.php). WS_PORT is
# the client-facing websocket port; WS_PUBLISH_PORT is the loopback-only port
# PHP-FPM requests publish events to (never expose WS_PUBLISH_PORT externally).
WS_PORT=9502
WS_PUBLISH_PORT=9503

# Base URL the FE approval landing page lives at — used to build the
# one-click WhatsApp approval link (https://{APPROVAL_BASE_URL}/approve/{token}).
APPROVAL_BASE_URL=https://aluria-dev.getmovira.com/

# SumoPod payment gateway (subscription checkout). API key and signing secret
# come from the SumoPod dashboard: Quick Start -> API Keys, Settings -> Webhook
# (secret is "whsec_..."). Live and Sandbox have separate keys/secrets.
# Success/cancel URLs are optional and override the project's configured return URLs.
SUMOPOD_BASE_URL=https://api-pay.sumopod.com
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_SUCCESS_URL=
SUMOPOD_CANCEL_URL=

# SSO — Movira identity provider integration.
# SSO_MOVIRA_API_URL is the base URL of the movira_api.
# SSO_CLIENT_ID and SSO_CLIENT_SECRET are the app_api_client credentials registered
# in movira_core for this application (APP_ID). The sso.exchange scope must be granted.
SSO_MOVIRA_API_URL=https://dev.getmovira.com/api/v2
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
