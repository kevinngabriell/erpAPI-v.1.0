APP_ENV=development

# development = your_dev_host | production = 127.0.0.1
DB_HOST=your_dev_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_pass

CORE_SCHEMA=movira_core_dev
APP_SCHEMA=aluria_dev

# Shared with the legacy (/auth, /user, /company, /master, ...) stack via
# auth/JWTConfig.php — do not fork this value, or legacy-issued tokens will
# fail signature verification against v2 and vice versa.
JWT_SECRET="your_jwt_secret_here"

# External APIs (optional)
WAHA_BASE_URL=
WAHA_SESSION=
WAHA_API_KEY=

# Notification WebSocket daemon (v2/notification/ws-server.php). WS_PORT is
# the client-facing websocket port; WS_PUBLISH_PORT is the loopback-only port
# PHP-FPM requests publish events to (never expose WS_PUBLISH_PORT externally).
WS_PORT=9502
WS_PUBLISH_PORT=9503

# Base URL the FE approval landing page lives at — used to build the
# one-click WhatsApp approval link (https://{APPROVAL_BASE_URL}/approve/{token}).
APPROVAL_BASE_URL=https://app.aluria.id
